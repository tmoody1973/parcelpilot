{
  "name": "parcelpilot",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "lint:copy": "node packages/contracts/src/cli/banned-phrases.ts apps/web/app apps/web/components apps/web/lib packages/zoning-core/src/memo packages/zoning-core/templates",
    "contracts:emit": "node packages/contracts/src/cli/emit-json-schema.ts",
    "db:migrate": "pnpm --filter @parcelpilot/db db:migrate",
    "db:generate": "pnpm --filter @parcelpilot/db db:generate",
    "seed:sources": "cd services/worker-py && uv run python -m app.seed_sources ../../data",
    "smoke:parcel": "node packages/zoning-core/src/cli/smoke-parcel.ts",
    "gis:snapshot": "node --conditions=development apps/worker/src/cli/gis-snapshot.ts",
    "smoke:intersections": "node --conditions=development packages/db/src/cli/smoke-intersections.ts",
    "rules:seed": "node --conditions=development packages/db/src/cli/seed-rules.ts",
    "test:gold": "pnpm --filter @parcelpilot/zoning-core test:gold",
    "gold:live": "node apps/web/scripts/gold-live.mjs",
    "ingest:pages": "cd services/worker-py && uv run python -m app.ingest_pages ../../data",
    "ingest:structure": "cd services/worker-py && uv run python -m app.ingest_structure",
    "ingest:tables": "cd services/worker-py && uv run python -m app.ingest_tables ../../data",
    "review:sweep": "node --conditions=development packages/db/src/cli/review-sweep.ts",
    "candidates:extract": "cd services/worker-py && uv run python -m app.extract_candidates",
    "rules:review-doc": "cd services/worker-py && uv run python -m app.rules_review_doc",
    "corpus:activate": "node --conditions=development packages/db/src/cli/corpus-activate.ts",
    "embed": "node --conditions=development packages/db/src/cli/embed.ts",
    "retrieve": "node --conditions=development packages/retrieval/src/cli/retrieve.ts",
    "retrieval:eval": "node --conditions=development packages/retrieval/src/cli/eval.ts",
    "retrieval:bakeoff": "node --conditions=development packages/retrieval/src/cli/bakeoff.ts",
    "evidence:bundle": "node --conditions=development packages/retrieval/src/cli/bundle.ts",
    "briefing:eval": "node --conditions=development packages/retrieval/src/cli/briefing-eval.ts",
    "briefing:run": "node --conditions=development packages/retrieval/src/cli/briefing-run.ts",
    "citation-support:eval": "node --conditions=development packages/retrieval/src/cli/citation-support-eval.ts",
    "decision:gold": "node --conditions=development packages/retrieval/src/cli/decision-gold.ts",
    "briefing:fixtures": "node --conditions=development packages/retrieval/src/cli/gold-brief-fixtures.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.20.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0"
  }
}
