# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://parcelpilot:parcelpilot@localhost:5432/parcelpilot
S3_ENDPOINT=http://localhost:9100
S3_BUCKET=parcelpilot-sources
S3_ACCESS_KEY_ID=parcelpilot
S3_SECRET_ACCESS_KEY=parcelpilot-local
TYPESAFE_API_KEY=replace-me
ANTHROPIC_API_KEY=replace-me
DECISION_MODE=rules_only

# Local docker compose host ports (override if they collide with another project)
PP_DB_PORT=5432
PP_MINIO_PORT=9100
PP_MINIO_CONSOLE_PORT=9101
PP_WORKER_PORT=8000
