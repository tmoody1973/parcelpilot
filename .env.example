# Copy to .env and fill in. Never commit .env.
# Owner (migrations only)
DATABASE_URL=postgres://parcelpilot:parcelpilot@localhost:5432/parcelpilot
# App (Row Level Security applies)
DATABASE_APP_URL=postgres://parcelpilot_app:parcelpilot-app@localhost:5432/parcelpilot
# Workers (bypasses RLS; jurisdiction-shared tables only, by convention)
DATABASE_SERVICE_URL=postgres://parcelpilot_service:parcelpilot-service@localhost:5432/parcelpilot
S3_ENDPOINT=http://localhost:9100
S3_BUCKET=parcelpilot-sources
S3_ACCESS_KEY_ID=parcelpilot
S3_SECRET_ACCESS_KEY=parcelpilot-local
TYPESAFE_API_KEY=replace-me
ANTHROPIC_API_KEY=replace-me
DECISION_MODE=rules_only

# Clerk auth (organizations enabled). Get keys from the Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-me
CLERK_SECRET_KEY=sk_test_replace-me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Local docker compose host ports (override if they collide with another project)
PP_DB_PORT=5432
PP_MINIO_PORT=9100
PP_MINIO_CONSOLE_PORT=9101
PP_WORKER_PORT=8000

# Evidence bundle size per feasibility run, in estimated tokens (MOO-835). Optional; default 6000.
# EVIDENCE_TOKEN_BUDGET=6000

# Decision layer (MOO-836): rules_only (default) or shadow. shadow asks JEV after each run is locked and only logs the
# answer (needs TYPESAFE_API_KEY). jev and structured_output_baseline are refused until the M6 gates pass.
# DECISION_MODE=shadow

# Briefing model (MOO-837, decision 014): default claude-opus-5-5 at effort medium; needs ANTHROPIC_API_KEY.
# Evaluated backup: openai/gpt-6-luna via OpenRouter (needs OPENROUTER_API_KEY; no zero-retention endpoint, eval use only).
# BRIEFING_MODEL=claude-opus-5-5

# Briefs (MOO-839): write, validate and show a model brief after each run. Opt-in: every brief is a paid call (~$0.20).
# BRIEFING_ENABLED=true
# The twelfth brief check (MOO-841): JEV confirms each cited excerpt supports its sentence. Off by default; measured
# 2026-09-23 it would send 8 of 15 gold briefs to the template (decision 017). Needs TYPESAFE_API_KEY.
# CITATION_SUPPORT_CHECK=true
