{
  "$id": "parcelpilot/PreparedState.v1",
  "title": "PreparedState",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "prepared_state.v1"
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_:.\\-]{1,64}$"
    },
    "parcel": {
      "type": "object",
      "properties": {
        "base_zoning": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_:.\\-]{1,64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "additional_zoning_districts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_:.\\-]{1,64}$"
          }
        },
        "overlays": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_:.\\-]{1,64}$"
          }
        },
        "special_districts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_:.\\-]{1,64}$"
          }
        },
        "planned_development": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_:.\\-]{1,64}$"
          }
        },
        "gis_ambiguities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_:.\\-]{1,64}$"
          }
        }
      },
      "required": [
        "base_zoning",
        "additional_zoning_districts",
        "overlays",
        "special_districts",
        "planned_development",
        "gis_ambiguities"
      ],
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "properties": {
        "use": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_:.\\-]{1,64}$"
        },
        "has_ground_floor_commercial": {
          "type": "boolean"
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_:.\\-]{1,64}$"
          }
        }
      },
      "required": [
        "use",
        "has_ground_floor_commercial",
        "missing_fields"
      ],
      "additionalProperties": false
    },
    "deterministic_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "use",
              "height",
              "setback_front",
              "setback_side",
              "setback_rear",
              "density",
              "parking",
              "lot_coverage"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "unknown",
              "verify",
              "insufficient_evidence"
            ]
          },
          "criticality": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "citation_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_:.\\-]{1,64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "category",
          "status",
          "criticality",
          "confidence",
          "citation_count",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "object",
      "properties": {
        "district_verified": {
          "type": "boolean"
        },
        "active_code_version": {
          "type": "boolean"
        },
        "citation_validator_passed": {
          "type": "boolean"
        },
        "evidence_bundle_available": {
          "type": "boolean"
        },
        "required_sections_found": {
          "type": "boolean"
        },
        "required_table_headers_found": {
          "type": "boolean"
        },
        "required_footnotes_found": {
          "type": "boolean"
        },
        "exception_detected": {
          "type": "boolean"
        },
        "overlay_detected": {
          "type": "boolean"
        },
        "overlay_rule_coverage": {
          "type": "string",
          "enum": [
            "none",
            "manual_review"
          ]
        },
        "unsupported_claims": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "conflicting_sources": {
          "type": "boolean"
        },
        "required_context_missing": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_:.\\-]{1,64}$"
          }
        },
        "stale_facts": {
          "type": "boolean"
        }
      },
      "required": [
        "district_verified",
        "active_code_version",
        "citation_validator_passed",
        "evidence_bundle_available",
        "required_sections_found",
        "required_table_headers_found",
        "required_footnotes_found",
        "exception_detected",
        "overlay_detected",
        "overlay_rule_coverage",
        "unsupported_claims",
        "conflicting_sources",
        "required_context_missing",
        "stale_facts"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "checked": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "use",
              "height",
              "setback_front",
              "setback_side",
              "setback_rear",
              "density",
              "parking",
              "lot_coverage"
            ]
          }
        },
        "manual_review": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_:.\\-]{1,64}$"
          }
        },
        "unknown": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "use",
              "height",
              "setback_front",
              "setback_side",
              "setback_rear",
              "density",
              "parking",
              "lot_coverage"
            ]
          }
        }
      },
      "required": [
        "checked",
        "manual_review",
        "unknown"
      ],
      "additionalProperties": false
    },
    "policy_flags": {
      "type": "object",
      "properties": {
        "deterministic_critical_fail": {
          "type": "boolean"
        },
        "special_district_detected": {
          "type": "boolean"
        },
        "missing_required_input": {
          "type": "boolean"
        },
        "gis_ambiguity": {
          "type": "boolean"
        }
      },
      "required": [
        "deterministic_critical_fail",
        "special_district_detected",
        "missing_required_input",
        "gis_ambiguity"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "jurisdiction",
    "parcel",
    "scenario",
    "deterministic_findings",
    "evidence",
    "coverage",
    "policy_flags"
  ],
  "additionalProperties": false
}
