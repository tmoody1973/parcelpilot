{
  "$id": "parcelpilot/EvaluateInput.v1",
  "title": "EvaluateInput",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "parcel": {
      "type": "object",
      "properties": {
        "lot_area_sqft": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "lot_area_suspect": {
          "default": false,
          "type": "boolean"
        },
        "base_zoning": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "planned_development": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "overlays": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "special_districts": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "floodplain": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gis_ambiguity": {
          "default": false,
          "type": "boolean"
        },
        "attributes": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": [
              "number",
              "string",
              "boolean",
              "null"
            ]
          }
        }
      },
      "required": [
        "lot_area_sqft",
        "lot_area_suspect",
        "base_zoning",
        "planned_development",
        "overlays",
        "special_districts",
        "floodplain",
        "gis_ambiguity",
        "attributes"
      ],
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "properties": {
        "use": {
          "type": "string",
          "minLength": 1
        },
        "units": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stories": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height_ft": {
          "type": "number",
          "minimum": 0
        },
        "footprint_sqft": {
          "type": "number",
          "minimum": 0
        },
        "setback_front_ft": {
          "type": "number",
          "minimum": 0
        },
        "setback_side_ft": {
          "type": "number",
          "minimum": 0
        },
        "setback_rear_ft": {
          "type": "number",
          "minimum": 0
        },
        "parking_spaces": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ground_floor_use": {
          "type": "string",
          "enum": [
            "retail",
            "residential",
            "none"
          ]
        },
        "ground_floor_commercial_sqft": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "use",
        "ground_floor_use"
      ],
      "additionalProperties": false
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "family_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "jurisdiction_id": {
            "type": "string",
            "minLength": 1
          },
          "district_code": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "use",
              "height",
              "setback_front",
              "setback_side",
              "setback_rear",
              "density",
              "parking",
              "lot_coverage"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "allowed_use",
              "max_height_ft",
              "min_height_ft",
              "min_setback_ft",
              "max_setback_ft",
              "min_lot_area_per_unit"
            ]
          },
          "params": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "conditions": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "when": {
                  "type": "object",
                  "properties": {
                    "fact": {
                      "type": "string",
                      "pattern": "^(scenario|parcel)\\.[a-z_.]+$"
                    },
                    "op": {
                      "type": "string",
                      "enum": [
                        "==",
                        "!=",
                        "in",
                        ">",
                        ">=",
                        "<",
                        "<="
                      ]
                    },
                    "value": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "string"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": [
                              "number",
                              "string"
                            ]
                          }
                        }
                      ]
                    }
                  },
                  "required": [
                    "fact",
                    "op",
                    "value"
                  ],
                  "additionalProperties": false
                },
                "evaluable": {
                  "type": "boolean"
                },
                "effect": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "param": {
                          "type": "string"
                        },
                        "value": {
                          "type": [
                            "number",
                            "string"
                          ]
                        }
                      },
                      "required": [
                        "param",
                        "value"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "const": "verify"
                        }
                      },
                      "required": [
                        "status"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "citation": {
                  "type": "object",
                  "properties": {
                    "citation_id": {
                      "type": "string"
                    },
                    "document_id": {
                      "type": "string"
                    },
                    "page": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "section": {
                      "type": "string"
                    },
                    "table": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "document_id",
                    "page",
                    "section"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "description",
                "evaluable",
                "effect",
                "citation"
              ],
              "additionalProperties": false
            }
          },
          "criticality": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "citations": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "citation_id": {
                  "type": "string"
                },
                "document_id": {
                  "type": "string"
                },
                "page": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "section": {
                  "type": "string"
                },
                "table": {
                  "type": "string"
                }
              },
              "required": [
                "document_id",
                "page",
                "section"
              ],
              "additionalProperties": false
            }
          },
          "effective_start": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "effective_end": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "const": "approved"
          }
        },
        "required": [
          "id",
          "family_id",
          "version",
          "jurisdiction_id",
          "district_code",
          "category",
          "kind",
          "params",
          "conditions",
          "criticality",
          "citations",
          "effective_start",
          "effective_end",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "categories_in_scope": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "use",
          "height",
          "setback_front",
          "setback_side",
          "setback_rear",
          "density",
          "parking",
          "lot_coverage"
        ]
      }
    },
    "analysis_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "required": [
    "parcel",
    "scenario",
    "rules",
    "categories_in_scope",
    "analysis_date"
  ],
  "additionalProperties": false
}
