{
  "$id": "parcelpilot/BriefingOutput.v1",
  "title": "BriefingOutput",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status_echo": {
      "type": "string",
      "enum": [
        "proceed_to_concept_design",
        "revise_scenario",
        "verify_before_committing",
        "insufficient_evidence"
      ]
    },
    "executive_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 400
          },
          "kind": {
            "type": "string",
            "enum": [
              "fact",
              "code",
              "finding",
              "advice",
              "framing"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "numbers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                },
                "calculation_id": {
                  "type": "string"
                }
              },
              "required": [
                "value",
                "calculation_id"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "text",
          "kind",
          "source_ids"
        ],
        "additionalProperties": false
      }
    },
    "status_explanation": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 400
          },
          "kind": {
            "type": "string",
            "enum": [
              "fact",
