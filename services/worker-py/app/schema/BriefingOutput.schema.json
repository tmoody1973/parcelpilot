              "finding",
              "advice",
              "framing"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "numbers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                },
                "calculation_id": {
                  "type": "string"
                }
              },
              "required": [
                "value",
                "calculation_id"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "text",
          "kind",
          "source_ids"
        ],
        "additionalProperties": false
      }
    },
    "verified_findings": {
      "type": "array",
