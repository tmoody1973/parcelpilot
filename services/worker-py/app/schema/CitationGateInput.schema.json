{
  "$id": "parcelpilot/CitationGateInput.v1",
  "title": "CitationGateInput",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "use",
              "height",
              "setback_front",
              "setback_side",
              "setback_rear",
              "density",
              "parking",
              "lot_coverage"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "unknown",
              "verify",
              "insufficient_evidence"
            ]
          },
          "criticality": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "rule_id": {
            "type": "string"
          },
          "rule_version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "proposed": {
            "type": "object",
            "properties": {
              "value": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "unit": {
                "type": "string"
              },
              "source": {
                "type": "string",
                "enum": [
                  "scenario",
                  "parcel"
                ]
              }
            },
            "required": [
              "value",
              "source"
            ],
            "additionalProperties": false
          },
          "allowed": {
            "type": "object",
            "properties": {
              "value": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "unit": {
                "type": "string"
              },
              "operator": {
                "type": "string",
                "enum": [
                  "<=",
                  ">=",
                  "in",
                  "=="
                ]
              }
            },
            "required": [
              "value",
              "operator"
            ],
            "additionalProperties": false
          },
          "calculation_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "citation_id": {
                  "type": "string"
                },
                "document_id": {
                  "type": "string"
                },
                "page": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "printed_page": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "section": {
                  "type": "string"
                },
                "table": {
                  "type": "string"
                },
                "excerpt": {
                  "type": "string"
                }
              },
              "required": [
                "document_id",
                "page",
                "section"
              ],
              "additionalProperties": false
            }
          },
          "reason": {
            "type": "string"
          },
          "missing_inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        },
        "required": [
          "category",
          "status",
          "criticality",
          "calculation_ids",
          "citations",
          "missing_inputs",
          "confidence"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending_review",
              "active",
              "superseded",
              "withdrawn"
            ]
          },
          "effective_start": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "effective_end": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "status",
          "effective_start",
          "effective_end"
        ],
        "additionalProperties": false
      }
    },
    "rules": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      }
    },
    "analysis_date": {
      "type": "string"
    }
  },
  "required": [
    "findings",
    "sources",
    "rules",
    "analysis_date"
  ],
  "additionalProperties": false
}
