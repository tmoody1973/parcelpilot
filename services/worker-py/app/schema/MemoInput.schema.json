{
  "$id": "parcelpilot/MemoInput.v1",
  "title": "MemoInput",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "memo_input.v1"
    },
    "run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "locked_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "analysis_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision_mode": {
          "type": "string"
        },
        "rules_engine_version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "created_at",
        "locked_at",
        "analysis_date",
        "decision_mode",
        "rules_engine_version"
      ],
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "properties": {
        "final_status": {
          "type": "string",
          "enum": [
            "proceed_to_concept_design",
            "revise_scenario",
            "verify_before_committing",
            "insufficient_evidence"
          ]
        },
        "route": {
          "type": "string",
          "enum": [
            "proceed_to_concept_design",
            "revise_scenario",
            "contact_city",
            "engage_zoning_professional",
            "collect_missing_information",
            "insufficient_evidence"
          ]
        },
        "risk": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "triggers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "policy_flags": {
          "type": "object",
          "properties": {
            "deterministic_critical_fail": {
              "type": "boolean"
            },
            "special_district_detected": {
              "type": "boolean"
            },
            "missing_required_input": {
              "type": "boolean"
            },
            "gis_ambiguity": {
              "type": "boolean"
            }
          },
          "required": [
            "deterministic_critical_fail",
            "special_district_detected",
            "missing_required_input",
            "gis_ambiguity"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "final_status",
        "route",
        "risk",
        "reasons",
        "triggers",
        "policy_flags"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "checked": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "use",
              "height",
              "setback_front",
              "setback_side",
              "setback_rear",
              "density",
              "parking",
              "lot_coverage"
            ]
          }
        },
        "manual_review": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "use",
              "height",
              "setback_front",
              "setback_side",
              "setback_rear",
              "density",
              "parking",
              "lot_coverage"
            ]
          }
        },
        "unknown": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "use",
              "height",
              "setback_front",
              "setback_side",
              "setback_rear",
              "density",
              "parking",
              "lot_coverage"
            ]
          }
        }
      },
      "required": [
        "checked",
        "manual_review",
        "unknown"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "citation_validator_passed": {
              "type": "boolean"
            },
            "active_code_version": {
              "type": "boolean"
            },
            "conflicting_sources": {
              "default": false,
              "type": "boolean"
            },
            "stale_facts": {
              "default": false,
              "type": "boolean"
            },
            "problems": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "citation_validator_passed",
            "active_code_version",
            "conflicting_sources",
            "stale_facts",
            "problems"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "use",
              "height",
              "setback_front",
              "setback_side",
              "setback_rear",
              "density",
              "parking",
              "lot_coverage"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "unknown",
              "verify",
              "insufficient_evidence"
            ]
          },
          "criticality": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "rule_id": {
            "type": "string"
          },
          "rule_version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "proposed": {
            "type": "object",
            "properties": {
              "value": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "unit": {
                "type": "string"
              },
              "source": {
                "type": "string",
                "enum": [
                  "scenario",
                  "parcel"
                ]
              }
            },
            "required": [
              "value",
              "source"
            ],
            "additionalProperties": false
          },
          "allowed": {
            "type": "object",
            "properties": {
              "value": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "unit": {
                "type": "string"
              },
              "operator": {
                "type": "string",
                "enum": [
                  "<=",
                  ">=",
                  "in",
                  "=="
                ]
              }
            },
            "required": [
              "value",
              "operator"
            ],
            "additionalProperties": false
          },
          "calculation_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "citation_id": {
                  "type": "string"
                },
                "document_id": {
                  "type": "string"
                },
                "page": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "printed_page": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "section": {
                  "type": "string"
                },
                "table": {
                  "type": "string"
                },
                "excerpt": {
                  "type": "string"
                }
              },
              "required": [
                "document_id",
                "page",
                "section"
              ],
              "additionalProperties": false
            }
          },
          "reason": {
            "type": "string"
          },
          "missing_inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        },
        "required": [
          "category",
          "status",
          "criticality",
          "calculation_ids",
          "citations",
          "missing_inputs",
          "confidence"
        ],
        "additionalProperties": false
      }
    },
    "scenario": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "inputs": {
          "type": "object",
          "properties": {
            "use": {
              "type": "string",
              "minLength": 1
            },
            "units": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "stories": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "height_ft": {
              "type": "number",
              "minimum": 0
            },
            "footprint_sqft": {
              "type": "number",
              "minimum": 0
            },
            "setback_front_ft": {
              "type": "number",
              "minimum": 0
            },
            "setback_side_ft": {
              "type": "number",
              "minimum": 0
            },
            "setback_rear_ft": {
              "type": "number",
              "minimum": 0
            },
            "parking_spaces": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "ground_floor_use": {
              "type": "string",
              "enum": [
                "retail",
                "residential",
                "none"
              ]
            },
            "ground_floor_commercial_sqft": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "use",
            "ground_floor_use"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "inputs"
      ],
      "additionalProperties": false
    },
    "parcel": {
      "type": "object",
      "properties": {
        "taxkey": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "lot_area_sqft": {
          "type": [
            "number",
            "null"
          ]
        },
        "lot_area_suspect": {
          "type": "boolean"
        },
        "base_zoning": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "overlays": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "special_districts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "planned_development": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "floodplain": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gis_ambiguity": {
          "type": "boolean"
        },
        "retrieved_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "snapshot_id": {
          "type": "string"
        }
      },
      "required": [
        "taxkey",
        "address",
        "lot_area_sqft",
        "lot_area_suspect",
        "base_zoning",
        "overlays",
        "special_districts",
        "planned_development",
        "floodplain",
        "gis_ambiguity",
        "retrieved_at",
        "snapshot_id"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "gis_layer_snapshot_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rule_version_set": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "input_hash": {
          "type": "string"
        }
      },
      "required": [
        "gis_layer_snapshot_ids",
        "rule_version_set",
        "input_hash"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "published_marker": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string"
          },
          "official_url": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "title",
          "published_marker",
          "status",
          "official_url"
        ],
        "additionalProperties": false
      }
    },
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "run",
    "decision",
    "coverage",
    "evidence",
    "findings",
    "scenario",
    "parcel",
    "provenance",
    "sources",
    "project"
  ],
  "additionalProperties": false
}
