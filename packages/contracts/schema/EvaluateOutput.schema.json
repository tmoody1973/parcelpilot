{
  "$id": "parcelpilot/EvaluateOutput.v1",
  "title": "EvaluateOutput",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "use",
              "height",
              "setback_front",
              "setback_side",
              "setback_rear",
              "density",
              "parking",
              "lot_coverage"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "unknown",
              "verify",
              "insufficient_evidence"
            ]
          },
          "criticality": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "rule_id": {
            "type": "string"
          },
          "rule_version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "proposed": {
            "type": "object",
            "properties": {
              "value": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "unit": {
                "type": "string"
              },
              "source": {
                "type": "string",
                "enum": [
                  "scenario",
                  "parcel"
                ]
              }
            },
            "required": [
              "value",
              "source"
            ],
            "additionalProperties": false
          },
          "allowed": {
            "type": "object",
            "properties": {
              "value": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "unit": {
                "type": "string"
              },
              "operator": {
                "type": "string",
                "enum": [
                  "<=",
                  ">=",
                  "in",
                  "=="
                ]
              }
            },
            "required": [
              "value",
              "operator"
            ],
            "additionalProperties": false
          },
          "calculation_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "citation_id": {
                  "type": "string"
                },
                "document_id": {
                  "type": "string"
                },
                "page": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "section": {
                  "type": "string"
                },
                "table": {
                  "type": "string"
                }
              },
              "required": [
                "document_id",
                "page",
                "section"
              ],
              "additionalProperties": false
            }
          },
          "reason": {
            "type": "string"
          },
          "missing_inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        },
        "required": [
          "category",
          "status",
          "criticality",
          "calculation_ids",
          "citations",
          "missing_inputs",
          "confidence"
        ],
        "additionalProperties": false
      }
    },
    "calculations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "use",
              "height",
              "setback_front",
              "setback_side",
              "setback_rear",
              "density",
              "parking",
              "lot_coverage"
            ]
          },
          "rule_id": {
            "type": "string"
          },
          "rule_version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "kind": {
            "type": "string",
            "enum": [
              "allowed_use",
              "max_height_ft",
              "min_height_ft",
              "min_setback_ft",
              "max_setback_ft",
              "min_lot_area_per_unit"
            ]
          },
          "inputs": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": [
                "number",
                "string",
                "boolean",
                "null"
              ]
            }
          },
          "proposed": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "allowed": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "operator": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "<=",
                  ">=",
                  "in",
                  "=="
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "unknown",
              "verify",
              "insufficient_evidence"
            ]
          },
          "detail": {
            "type": "string"
          },
          "conditions_applied": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "category",
          "rule_id",
          "rule_version",
          "kind",
          "inputs",
          "proposed",
          "allowed",
          "operator",
          "status",
          "detail",
          "conditions_applied"
        ],
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "object",
      "properties": {
        "checked": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "use",
              "height",
              "setback_front",
              "setback_side",
              "setback_rear",
              "density",
              "parking",
              "lot_coverage"
            ]
          }
        },
        "manual_review": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "use",
              "height",
              "setback_front",
              "setback_side",
              "setback_rear",
              "density",
              "parking",
              "lot_coverage"
            ]
          }
        },
        "unknown": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "use",
              "height",
              "setback_front",
              "setback_side",
              "setback_rear",
              "density",
              "parking",
              "lot_coverage"
            ]
          }
        }
      },
      "required": [
        "checked",
        "manual_review",
        "unknown"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "findings",
    "calculations",
    "coverage"
  ],
  "additionalProperties": false
}
