{
  "$id": "parcelpilot/EvidenceBundle.v1",
  "title": "EvidenceBundle",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "evidence_bundle.v1"
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "retrieval_run_ids": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "analysis_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "embedding_version_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "token_budget": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "tokens_used": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "chunk_id": {
            "type": "string",
            "minLength": 1
          },
          "official_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "document_title": {
            "type": "string",
            "minLength": 1
          },
          "document_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "section": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "printed_page": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "anchors": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "page": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "page_end": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "bbox": {
                  "minItems": 4,
                  "maxItems": 4,
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                "row_index_on_page": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "page"
              ],
              "additionalProperties": false
            }
          },
          "verbatim_excerpt": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "const": "active"
          },
          "category": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "use",
                  "height",
                  "setback_front",
                  "setback_side",
                  "setback_rear",
                  "density",
                  "parking",
                  "lot_coverage"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "subquestion": {
            "type": "string",
            "minLength": 1
          },
          "required_context_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "selection_reason": {
            "type": "string",
            "minLength": 1
          },
          "rank": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "footnote_markers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "token_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "source_id",
          "chunk_id",
          "official_url",
          "document_title",
          "document_sha256",
          "section",
          "page",
          "printed_page",
          "anchors",
          "verbatim_excerpt",
          "status",
          "category",
          "subquestion",
          "required_context_type",
          "selection_reason",
          "rank",
          "footnote_markers",
          "token_count"
        ],
        "additionalProperties": false
      }
    },
    "required_context": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "boolean"
        }
      }
    },
    "flags": {
      "type": "object",
      "properties": {
        "active_version_confirmed": {
          "type": "boolean"
        },
        "overlay_detected": {
          "type": "boolean"
        },
        "coverage_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dropped_for_budget": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "refused_inactive": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "active_version_confirmed",
        "overlay_detected",
        "coverage_gaps",
        "dropped_for_budget",
        "refused_inactive"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "run_id",
    "retrieval_run_ids",
    "analysis_date",
    "embedding_version_id",
    "token_budget",
    "tokens_used",
    "items",
    "required_context",
    "flags"
  ],
  "additionalProperties": false
}
